# OilTech Radar — конфигурация (НЕ коммитить секреты)
# Скопируйте в .env и заполните ключи.

API_KEY=
BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# Опционально: отдельный Lab LLM (скрипты scripts/*_lab.py)
# Если не заданы — используются API_KEY / BASE_URL / LLM_MODEL выше.
LAB_API_KEY=
LAB_BASE_URL=http://127.0.0.1:54000/v1
LAB_LLM_MODEL=gpt-oss-120b

# Подкластеры
SUBCLUSTER_MIN_PARENT_SIZE=12
SUBCLUSTER_MIN_SIZE=4
SUBCLUSTER_MIN_ENTROPY=1.0

# Расписание: weekly | daily | manual
UPDATE_MODE=weekly
# Cron для weekly (понедельник 09:00) / daily
UPDATE_CRON=0 9 * * 1
SCHEDULER_RUN_ON_START=0

# Инкремент: сколько дней назад скрейпить (weekly=7, daily=1)
SCRAPE_DAYS=7
# Полный backfill (месяцы) — только для команды --backfill
BACKFILL_MONTHS=12

# Кластеризация
CLUSTER_VIEW=topic_plus_summary
ASSIGN_SIMILARITY_THRESHOLD=0.72
UMAP_N_NEIGHBORS=10
UMAP_MIN_DIST=0.0
UMAP_N_COMPONENTS=10
HDBSCAN_MIN_CLUSTER_SIZE=3
HDBSCAN_MIN_SAMPLES=2

# Сервер портала
HOST=127.0.0.1
PORT=8085

# Режим без LLM (эвристики) — 1/0
FORCE_HEURISTIC=0

# Роспатент Search Platform (JWT из UI «Генерирование ключей»)
SEARCHPLATFORM_API_KEY=
SEARCHPLATFORM_API_BASE=https://searchplatform.rospatent.gov.ru

# Firecrawl: запасной загрузчик универсального парсера.
# Вызывается, только если наш парсер по сайту ничего не нашёл.
# Self-host: FIRECRAWL_API_URL=http://localhost:3002 (ключ не нужен)
# Облако:    FIRECRAWL_API_KEY=fc-... (URL можно не указывать)
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=45000
# Лимит страниц Firecrawl на один запасной прогон источника
FIRECRAWL_MAX_PAGES=40
